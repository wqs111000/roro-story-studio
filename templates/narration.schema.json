{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roro.local/schemas/narration.schema.json",
  "title": "Roro Story Narration Draft",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "story_id", "status", "audio_rendered", "default_pace", "voices", "segments"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "story_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "status": { "enum": ["draft", "approved"] },
    "audio_rendered": { "type": "boolean" },
    "default_pace": { "enum": ["slow", "medium"] },
    "voices": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tone", "pace"],
        "properties": {
          "tone": { "type": "string", "minLength": 1, "maxLength": 100 },
          "pace": { "enum": ["slow", "medium"] }
        }
      }
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "page", "speaker", "emotion", "text", "pause_after_ms"],
        "properties": {
          "id": { "type": "string", "pattern": "^p[1-6]-[0-9]{2}$" },
          "page": { "type": "integer", "minimum": 1, "maximum": 6 },
          "speaker": { "type": "string", "minLength": 1, "maxLength": 20 },
          "speech_cue": { "type": "string", "minLength": 1, "maxLength": 60 },
          "emotion": { "enum": ["calm", "curious", "happy", "gentle", "concerned", "proud", "sleepy"] },
          "text": { "type": "string", "minLength": 1, "maxLength": 500 },
          "pause_after_ms": { "type": "integer", "minimum": 0, "maximum": 8000 },
          "interaction": { "type": ["string", "null"], "maxLength": 120 }
        }
      }
    }
  }
}
